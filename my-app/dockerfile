# multistage dockerfile

FROM node:18 AS build
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
RUN npm run build

# stage 2
FROM node:18-alpine as production
WORKDIR /app
COPY from=build /app/package*.json ./
RUN npm install --only=production
COPY from=build /app/dist ./dist
EXPOSE 3000
CMD ["node", "dist/main.js"]